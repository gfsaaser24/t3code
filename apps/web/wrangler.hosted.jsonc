// Hosted static app deployment for app.t3turbo.pro (fork equivalent of app.t3.codes).
// Deploy: npx wrangler deploy --config wrangler.hosted.jsonc
{
  "name": "t3turbo-hosted-app",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "app.t3turbo.pro",
      "custom_domain": true,
    },
  ],
}
